# Copy to .env or configure in the local settings window. Never commit real secrets.
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
TEXT_MODEL=deepseek-flash
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
VISION_MODEL=qwen3-vl-plus
IMAGE_MODEL=qwen-image-2.1-pro
TAVILY_API_KEY=
PUBLIC_API_BASE=
TOOL_TOKEN=
# IMA credentials are read from IMA_OPENAPI_CLIENTID / IMA_OPENAPI_APIKEY,
# or existing ~/.config/ima/client_id and ~/.config/ima/api_key.
# They are never copied into the project settings.

# Optional private share link for source fallback; leave empty for public deployments.
IMA_KNOWLEDGE_SHARE_URL=

# Hosted reverse proxies: exact HTTPS origins as a JSON string array. Leave
# empty for direct local use. Never use wildcard origins for the hosted app.
STUDIO_ALLOWED_ORIGINS=
